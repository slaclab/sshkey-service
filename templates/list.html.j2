<!DOCTYPE html>
<html>
<head>
    <title>{{ title }}</title>
    <style>
        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            background-color: #cccccc;
        }
        input:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            background-color: #f0f0f0;
        }
        .blacklist-warning {
            cursor: help;
            font-size: 1.2em;
        }
        .blacklist-warning:hover {
            filter: brightness(1.2);
        }
        .disable {
            color: #fff;
            background-color: #b00020;
            border: 1px solid #b00020;
        }
        .disabled-status {
            cursor: help;
        }
        /* revoked (permanently disabled) keys are hidden unless "show revoked keys" is ticked */
        #mykeys tr.disabled-key {
            display: none;
            color: #888;
        }
        #mykeys.show-disabled tr.disabled-key {
            display: table-row;
        }
        .key-legend {
            font-size: 0.9em;
            color: #444;
        }
    </style>
</head>
<body>
    <h1>{{ username }}</h1>

    <p>Register new public key: <button onclick="window.location.href='/register/{{ username }}'" class="register">Register</button></p>

    {% if no_expiry %}
    <p>SSH key expiry disabled</p>
    {% endif %}

    <p class="key-legend">
        ✅ <b>Active</b>: the key can be used to log in.
        ❌ <b>Inactive</b>: suspended or expired; click <b>Refresh</b> to use it again.
        🚫 <b>Revoked</b>: permanently turned off. It can never be used or registered again.
    </p>

    {% if disabled_count %}
    <p><label><input type="checkbox" id="show-disabled"> Show revoked keys ({{ disabled_count }})</label></p>
    {% endif %}

    <table id="mykeys">
    <tr>
        <th>finger print</th>
        <th>is_active</th>
        <th>created_at</th>
        <th>source_ip</th>
        <th>valid_until</th>
    {% if not no_expiry %}
        <th>expires_at</th>
    {% endif %}
        <th>user_notes</th>
        <th>action</th>
    </tr>
{% for key in keys %}
    {% set locked = key.get('is_blacklisted') or key.get('is_disabled') %}
    <tr data-fingerprint="{{ key['finger_print'] }}"{% if key.get('is_disabled') %} class="disabled-key"{% endif %}>

    <td>
{{ key['finger_print'] }}
    </td>
    <td>
{% if key.get('is_disabled') %}<span class="disabled-status" title="Revoked {{ key.get('disabled_at', '') }} by {{ key.get('disabled_by', '') }}{% if key.get('disabled_reason') %}: {{ key['disabled_reason'] }}{% endif %}">🚫</span>{% elif key.get('is_blacklisted') %}<span class="blacklist-warning" title="This SSH key fingerprint is BLACKLISTED">⚠️</span>{% elif key.get('is_active') == "1" %}✅{% else %}❌{% endif %}
    </td>
    <td class="datetime" data-utc="{{ key['created_at'] }}">
{{ key['created_at'] }}
    </td>
    <td>
{{ key['source_ip'] }}
    </td>
    <td class="datetime" data-utc="{{ key['valid_until'] }}">
{{ key['valid_until'] }}
    </td>
{% if not no_expiry %}
    <td class="datetime" data-utc="{{ key['expires_at'] }}">
{{ key['expires_at'] }}
    </td>
{% endif %}
    <td>
    <input type="text" class="user-notes" value="{{ key.get('user_notes', '') }}" placeholder="Add notes..." style="width: 200px;" data-original-value="{{ key.get('user_notes', '') }}"{% if locked %} disabled{% endif %}>
    </td>
    <td>
    {% if key.get('is_disabled') %}
    <span title="Revoked keys cannot be refreshed or changed">Revoked</span>
    {% else %}
    <button class="refresh"{% if locked %} disabled{% endif %} title="Make this key active again for another {{ (validity_period / 3600) | int }} hours.">Refresh</button>
    <button class="inactivate"{% if locked %} disabled{% endif %} title="Temporarily stop this key. Click Refresh to resume it.">Suspend</button>
    <button class="disable"{% if locked %} disabled{% endif %} title="Permanently turn off this key, e.g. if it may be compromised or the device holding it is lost. This CANNOT be undone; you will need to generate and register a new key.">Revoke</button>
    {% endif %}
    </td>




    </tr>
{% endfor %}
    </table>

<script type="text/javascript">
    const username = "{{ username }}";

    const fpoperation = function(url, method, body) {
        const opts = { "method": method };
        if (body !== undefined) {
            opts.headers = { "Content-Type": "application/json" };
            opts.body = JSON.stringify(body);
        }
        fetch(url, opts)
        .then(async response => {
            if (response.ok) {
              return response.text();
            } else {
              let detail = `Server error: ${response.status}`;
              try { detail = (await response.json()).detail || detail; } catch (e) {}
              throw new Error(detail);
            }
        })
        .then(data => {
            console.log("Reloading the page");
            window.location.reload();
        })
        .catch(error => {
            alert(error.message);
        })
    }

    document.querySelectorAll(".refresh").forEach((el) => el.addEventListener("click", (ev) => {
        if (ev.currentTarget.disabled) return;
        const fingerprint = ev.currentTarget.closest("tr").getAttribute("data-fingerprint");
        fpoperation(`../refresh/${username}/${fingerprint}`, "PATCH");
    }))
    document.querySelectorAll(".inactivate").forEach((el) => el.addEventListener("click", (ev) => {
        if (ev.currentTarget.disabled) return;
        const fingerprint = ev.currentTarget.closest("tr").getAttribute("data-fingerprint");
        fpoperation(`../inactivate/${username}/${fingerprint}`, "DELETE");
    }))
    document.querySelectorAll(".disable").forEach((el) => el.addEventListener("click", (ev) => {
        if (ev.currentTarget.disabled) return;
        const fingerprint = ev.currentTarget.closest("tr").getAttribute("data-fingerprint");
        if (!confirm(`WARNING: revoking is PERMANENT.\n\nRevoke key ${fingerprint}?\n\nThis CANNOT be undone. The key will stop working immediately and can never be registered again. You will need to generate a new keypair.\n\n(If you only want to stop it for now, use Suspend instead.)`)) return;
        const reason = prompt("Optional: why are you revoking this key? (e.g. lost laptop, possibly compromised)", "");
        if (reason === null) return;
        fpoperation(`../disable/${username}/${fingerprint}`, "POST", { reason: reason });
    }))

    // show/hide permanently disabled keys; remember the choice per browser
    const showDisabled = document.getElementById("show-disabled");
    if (showDisabled) {
        const table = document.getElementById("mykeys");
        const apply = () => table.classList.toggle("show-disabled", showDisabled.checked);
        try { showDisabled.checked = localStorage.getItem("sshkey-show-disabled") === "1"; } catch (e) {}
        apply();
        showDisabled.addEventListener("change", () => {
            apply();
            try { localStorage.setItem("sshkey-show-disabled", showDisabled.checked ? "1" : "0"); } catch (e) {}
        });
    }

    // Function to save user notes
    const saveUserNotes = (input) => {
        // Don't save if input is disabled (e.g., blacklisted key)
        if (input.disabled) return;

        const row = input.closest("tr");
        const fingerprint = row.getAttribute("data-fingerprint");
        const userNotes = input.value;
        const originalValue = input.getAttribute("data-original-value");

        // Only save if the value has changed
        if (userNotes !== originalValue) {
            fetch(`../notes/${username}/${fingerprint}`, {
                method: "PATCH",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ user_notes: userNotes })
            })
            .then(response => {
                if (response.ok) {
                    // Update the original value to the new saved value
                    input.setAttribute("data-original-value", userNotes);
                    // Optional: Visual feedback - briefly change border color
                    input.style.borderColor = "green";
                    setTimeout(() => { input.style.borderColor = ""; }, 1000);
                    return response.text();
                } else {
                    throw new Error(`Server error: ${response.status}`);
                }
            })
            .catch(error => {
                alert('Error saving notes: ' + error);
                // Revert to original value on error
                input.value = originalValue;
            });
        }
    };

    // Auto-save user notes on blur (when user leaves the field)
    document.querySelectorAll(".user-notes").forEach((el) => {
        el.addEventListener("blur", (ev) => {
            saveUserNotes(ev.currentTarget);
        });

        // Auto-save user notes on Enter key press
        el.addEventListener("keypress", (ev) => {
            if (ev.key === "Enter") {
                ev.preventDefault(); // Prevent form submission if in a form
                saveUserNotes(ev.currentTarget);
                ev.currentTarget.blur(); // Remove focus from input after saving
            }
        });
    })

    const padNumber = (value) => String(value).padStart(2, "0");

    const formatDateToLocal = (raw) => {
        if (!raw) {
            return "";
        }
        const normalized = raw.includes("T") ? raw : raw.replace(" ", "T");
        const date = new Date(normalized);
        if (isNaN(date)) {
            const fallback = raw.split(".")[0].replace("T", " ");
            return fallback;
        }
        const year = date.getFullYear();
        const month = padNumber(date.getMonth() + 1);
        const day = padNumber(date.getDate());
        const hours = padNumber(date.getHours());
        const minutes = padNumber(date.getMinutes());
        const seconds = padNumber(date.getSeconds());
        return `${year}-${month}-${day}T${hours}:${minutes}:${seconds}`;
    };

    document.querySelectorAll("td[data-utc]").forEach((el) => {
        const formatted = formatDateToLocal(el.getAttribute("data-utc"));
        el.textContent = formatted;
    });
</script>
</html>
